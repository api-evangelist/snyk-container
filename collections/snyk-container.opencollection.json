                "type": "query",
                "description": "Filter issues by scan item type"
              },
              {
                "name": "scan_item.id",
                "value": "",
                "type": "query",
                "description": "Filter issues by project ID"
              },
              {
                "name": "severity",
                "value": "",
                "type": "query",
                "description": "Filter by severity level"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
